; Arquivo de configuração do projeto Godot 4.
; Normalmente você edita isso pela tela "Projeto > Configurações do Projeto".

config_version=5

[application]

config/name="Sobe, Engenheiro!"
config/description="Arcade de plataforma vertical: um engenheiro mecânico precisa subir um prédio em obra."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=568
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.16, 1)
